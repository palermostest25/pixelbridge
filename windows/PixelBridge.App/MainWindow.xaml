<Window x:Class="PixelBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelBridge" Height="820" Width="1240" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation pane -->
        <DockPanel Margin="8,6,4,10">
            <StackPanel DockPanel.Dock="Top" Margin="12,8,12,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="17"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="PixelBridge" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="NavStatusPill" Style="{StaticResource Pill}" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="NavStatusDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NavStatusText" Text="Starting…" Margin="8,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ListBox x:Name="FooterNav" DockPanel.Dock="Bottom" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"/>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Nav_SelectionChanged"/>
        </DockPanel>

        <!-- Content -->
        <Border Grid.Column="1" Margin="0,0,0,0" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PageHost" Margin="40,28,40,40" MaxWidth="1100"/>
                </ScrollViewer>
                <!-- Toast -->
                <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Padding="16,10" CornerRadius="8" MaxWidth="640"
                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
