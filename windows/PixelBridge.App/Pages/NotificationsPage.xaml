<UserControl x:Class="PixelBridge.App.Pages.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PixelBridge.App.Controls">
    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="Clear all" Click="Clear_Click" VerticalAlignment="Center"/>
            <TextBlock Text="Notifications" Style="{StaticResource TitleTextBlockStyle}"/>
        </DockPanel>
        <c:SettingCard Header="Show phone notifications here" Description="Also needs Notification access for PixelBridge on the phone" Glyph="&#xEA8F;">
            <CheckBox x:Name="Enable" Style="{StaticResource ToggleSwitch}" Click="Enable_Click"/>
        </c:SettingCard>
        <c:SettingCard Header="Show sender and message text" Description="Off: only the app name is shown. The phone app must allow it too. Nothing is saved to disk." Glyph="&#xE72E;">
            <CheckBox x:Name="ContentSwitch" Style="{StaticResource ToggleSwitch}" Click="Content_Click"/>
        </c:SettingCard>
        <c:SettingCard Header="Notification access on the phone" Glyph="&#xE8EA;">
            <Button Content="Open phone settings" Click="OpenAccess_Click"/>
        </c:SettingCard>

        <TextBlock Text="Recent" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="Empty" Text="No notifications yet." Style="{StaticResource Secondary}" Margin="2,0,0,0"/>
        <ItemsControl x:Name="List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Received, StringFormat=HH:mm}" Style="{StaticResource Secondary}"/>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding App}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{Binding Sender}" Visibility="{Binding Sender, Converter={x:Static c:NullToCollapsed.Instance}}"/>
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Secondary}" Visibility="{Binding Text, Converter={x:Static c:NullToCollapsed.Instance}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
