<UserControl x:Class="PixelBridge.App.Pages.PhonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PixelBridge.App.Controls">
    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
        <TextBlock Text="Phone screen" Style="{StaticResource PageTitle}"/>
        <Border Style="{StaticResource Card}" Padding="24,20">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Content="Show phone screen" Padding="16,7" VerticalAlignment="Center" Click="Mirror_Click"/>
                <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="28" Margin="0,0,18,0"/>
                <StackPanel>
                    <TextBlock Text="Control the phone from this PC" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"/>
                    <TextBlock Text="The Pixel's display doesn't work, so use this window to answer Android permission prompts and change phone settings. Uses your current USB or Wi-Fi connection." Style="{StaticResource Secondary}" Margin="0,4,12,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <c:SettingCard Header="Open PixelBridge on a separate virtual screen" Description="Useful if the main screen is locked or busy" Glyph="&#xE7F9;">
            <Button Content="Open" Click="VirtualDisplay_Click"/>
        </c:SettingCard>
        <c:SettingCard Header="Bring the phone app to the front" Description="Needed after a phone restart before the camera or microphone can start" Glyph="&#xE8A7;">
            <Button Content="Bring to front" Click="Launch_Click"/>
        </c:SettingCard>

        <c:SettingCard x:Name="WirelessCard" Header="Connect over Wi-Fi" Description="Set up once over USB, then unplug. Keep both devices on the same private Wi-Fi network." Glyph="&#xE701;">
            <StackPanel>
                <Button x:Name="WirelessSetup" Content="Set up over USB…" Click="Wireless_Click"/>
                <Button x:Name="WirelessOff" Content="Turn off wireless" Click="WirelessOff_Click" Margin="0,6,0,0"/>
            </StackPanel>
        </c:SettingCard>
        <Expander Header="Pair without a cable" Margin="0,8,0,12">
            <StackPanel Margin="16,12">
                <TextBlock Style="{StaticResource Secondary}" Text="On Android 11+, open Settings → System → Developer options → Wireless debugging → Pair device with pairing code. Keep that dialog open."/>
                <TextBlock Text="Pairing address (IP:port)" Margin="0,12,0,4"/>
                <TextBox x:Name="WirelessAddress"/>
                <TextBlock Text="Six-digit pairing code" Margin="0,12,0,4"/>
                <PasswordBox x:Name="WirelessCode"/>
                <TextBlock Text="Connection address (optional if discovered automatically)" Margin="0,12,0,4"/>
                <TextBox x:Name="WirelessConnectAddress"/>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,12" Text="The connection port is on the main Wireless debugging page and differs from the pairing port. If discovery fails, enter it and choose Connect paired phone."/>
                <WrapPanel>
                    <Button x:Name="WirelessPair" Content="Pair &amp; connect" Click="WirelessPair_Click" Margin="0,0,10,0"/>
                    <Button x:Name="WirelessConnect" Content="Connect paired phone" Click="WirelessConnect_Click"/>
                </WrapPanel>
            </StackPanel>
        </Expander>
        <TextBlock x:Name="WirelessMessage" Style="{StaticResource Secondary}" Margin="0,0,0,12"/>
        <TextBlock Text="Phone app" Style="{StaticResource SectionTitle}"/>
        <c:SettingCard x:Name="AppCard" Header="PixelBridge for Android" Glyph="&#xE74C;">
            <Button Content="Install or update…" Click="Install_Click"/>
        </c:SettingCard>
        <c:SettingCard Header="ADB keys from another computer" Description="Choose adbkey with adbkey.pub beside it. Current keys are backed up before reconnecting." Glyph="&#xE8D7;">
            <Button Content="Import ADB keys…" Click="ImportKeys_Click"/>
        </c:SettingCard>
        <c:SettingCard Header="Pairing" Description="Removes this PC's key. You'll need to pair again" Glyph="&#xE8D7;">
            <Button Content="Unpair" Click="Unpair_Click"/>
        </c:SettingCard>
    </StackPanel>
</UserControl>
