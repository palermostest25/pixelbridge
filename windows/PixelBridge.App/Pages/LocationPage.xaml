<UserControl x:Class="PixelBridge.App.Pages.LocationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PixelBridge.App.Controls">
    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="StartStop" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" MinWidth="150" Padding="14,6" Click="StartStop_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81D;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StartStopText" Text="Start location"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Location" Style="{StaticResource TitleTextBlockStyle}"/>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="FixTitle" Text="Location is off" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"/>
                    <TextBlock x:Name="Coords" Text="" FontFamily="Cascadia Mono, Consolas" FontSize="22" Margin="0,10,0,2"/>
                    <TextBlock x:Name="FixDetail" Style="{StaticResource Secondary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="MapButton" Content="Open in map" Click="Map_Click" Margin="0,0,8,0"/>
                        <Button x:Name="CopyButton" Content="Copy coordinates" Click="Copy_Click"/>
                    </StackPanel>
                </StackPanel>
                <!-- Satellite meter -->
                <Grid Grid.Column="1" Width="140" Height="140" Margin="20,0,0,0">
                    <Ellipse Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1"/>
                    <Ellipse Margin="28" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="SatCount" Text="0" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SatLabel" Text="satellites" Style="{StaticResource Secondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0"><StackPanel><TextBlock Text="Accuracy" Style="{StaticResource Secondary}"/><TextBlock x:Name="Acc" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Grid.Column="2"><StackPanel><TextBlock Text="Altitude" Style="{StaticResource Secondary}"/><TextBlock x:Name="Alt" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Grid.Column="4"><StackPanel><TextBlock Text="Speed" Style="{StaticResource Secondary}"/><TextBlock x:Name="Speed" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Grid.Column="6"><StackPanel><TextBlock Text="Source" Style="{StaticResource Secondary}"/><TextBlock x:Name="Source" Text="—" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
        </Grid>

        <TextBlock Text="Share with other apps" Style="{StaticResource SectionTitle}"/>
        <c:SettingCard Header="Hide precise coordinates" Description="Shows only about 1 km precision on screen" Glyph="&#xE72E;">
            <CheckBox x:Name="Hide" Style="{StaticResource ToggleSwitch}" Click="Hide_Click"/>
        </c:SettingCard>
        <c:SettingCard x:Name="NmeaCard" Header="NMEA GPS feed" Glyph="&#xE968;">
            <CheckBox x:Name="Nmea" Style="{StaticResource ToggleSwitch}" Click="Nmea_Click"/>
        </c:SettingCard>
        <c:SettingCard Header="Include location in the developer API" Description="Adds location messages to the local sensor WebSocket" Glyph="&#xE943;">
            <CheckBox x:Name="ApiLoc" Style="{StaticResource ToggleSwitch}" Click="ApiLoc_Click"/>
        </c:SettingCard>
        <TextBlock Style="{StaticResource Secondary}" Margin="2,8,0,0"
                   Text="Windows' own Location setting can't use the phone without a sensor driver. Apps that accept an NMEA/TCP GPS source can use the feed above. Location is never written to PixelBridge logs."/>
    </StackPanel>
</UserControl>
