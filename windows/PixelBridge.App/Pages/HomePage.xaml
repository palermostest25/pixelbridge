<UserControl x:Class="PixelBridge.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Hero -->
        <Border Style="{StaticResource Card}" Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Phone illustration -->
                <Border Width="62" Height="112" CornerRadius="12" BorderThickness="3" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                        Background="#FF101114" Margin="0,0,28,0">
                    <Grid>
                        <Ellipse Width="6" Height="6" Fill="#55FFFFFF" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <TextBlock x:Name="HeroGlyph" Text="&#xE839;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="22" Foreground="#99FFFFFF"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceName" Text="Pixel 7" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="30"/>
                    <TextBlock x:Name="DeviceStatus" Text="Looking for your phone…" Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,10"/>
                    <WrapPanel x:Name="Chips"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource AccentButtonStyle}" MinWidth="140" Padding="16,7" Click="Connect_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="Privacy mode" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <CheckBox x:Name="PrivacySwitch" Style="{StaticResource ToggleSwitch}" Click="Privacy_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action needed -->
        <Border x:Name="ActionBar" Style="{StaticResource Card}" Visibility="Collapsed" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" Padding="16,12">
            <DockPanel>
                <Button x:Name="ActionButton" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Click="Action_Click"/>
                <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Margin="0,0,12,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ActionTitle" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="ActionText" Style="{StaticResource Secondary}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Text="Features" Style="{StaticResource SectionTitle}"/>
        <UniformGrid x:Name="Tiles" Columns="3"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Battery" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                        <TextBlock x:Name="BatteryPercent" Text="—" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BatteryTemp" Text="" FontSize="16" Margin="14,0,0,6" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ProgressBar x:Name="BatteryBar" Height="4" Maximum="100"/>
                    <TextBlock x:Name="BatteryDetail" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="This phone has a history of battery repairs. Keep camera sessions supervised. If it gets hot, swells or smells, unplug it."/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Connection" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="LinkSummary" Style="{StaticResource BodyTextBlockStyle}" Margin="0,10,0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LinkDetail" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OtherDevices" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
