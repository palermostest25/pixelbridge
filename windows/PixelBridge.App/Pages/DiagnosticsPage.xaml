<UserControl x:Class="PixelBridge.App.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Run checks" Style="{StaticResource AccentButtonStyle}" Click="Doctor_Click" Margin="0,0,8,0"/>
                <Button Content="Export diagnostics" Click="Export_Click" Margin="0,0,8,0"/>
                <Button Content="Open log folder" Click="Logs_Click"/>
            </StackPanel>
            <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}"/>
        </DockPanel>
        <Border Style="{StaticResource Card}" x:Name="DoctorCard" Visibility="Collapsed">
            <TextBox x:Name="DoctorText" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <TextBlock Text="Activity log" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}" Padding="4">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Height="420" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </StackPanel>
</UserControl>
