<UserControl x:Class="PixelBridge.App.Pages.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PixelBridge.App.Controls">
    <StackPanel MaxWidth="940" HorizontalAlignment="Stretch">
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Click="Refresh_Click" Padding="12,6">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Refresh"/></StackPanel>
            </Button>
            <TextBlock Text="Internet sharing" Style="{StaticResource TitleTextBlockStyle}"/>
        </DockPanel>

        <!-- USB tethering hero -->
        <Border Style="{StaticResource Card}" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="TetherIcon" Width="56" Height="56" CornerRadius="12" Margin="0,0,20,0" VerticalAlignment="Top"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="&#xE839;" Style="{StaticResource Glyph}" FontSize="26" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="USB tethering" Style="{StaticResource Secondary}"/>
                    <TextBlock x:Name="TetherTitle" Text="Checking…" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="20" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TetherDetail" Style="{StaticResource Secondary}" Margin="0,6,0,0"/>
                    <WrapPanel x:Name="TetherChips" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <c:SettingCard Header="Which connection Windows uses for internet" Description="Changing this asks for administrator approval" Glyph="&#xE774;">
            <Border CornerRadius="6" Background="{DynamicResource ControlAltFillColorSecondaryBrush}" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RouteAuto" Content="Automatic" GroupName="route" Style="{StaticResource Segment}" Click="Route_Click" Tag="auto"/>
                    <RadioButton x:Name="RoutePhone" Content="Pixel" GroupName="route" Style="{StaticResource Segment}" Click="Route_Click" Tag="phone"/>
                    <RadioButton x:Name="RoutePc" Content="This PC's network" GroupName="route" Style="{StaticResource Segment}" Click="Route_Click" Tag="pc"/>
                </StackPanel>
            </Border>
        </c:SettingCard>
        <c:SettingCard Header="Turn tethering on or off on the phone" Description="Opens Android's Hotspot &amp; tethering screen in a phone window" Glyph="&#xE8A7;">
            <Button Content="Open tethering settings" Click="OpenTether_Click"/>
        </c:SettingCard>

        <TextBlock Text="Phone's connections" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}" Padding="8">
            <ItemsControl x:Name="Networks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="8,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Right}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Width="34"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="Wi-Fi" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan nearby" VerticalAlignment="Center" Click="Scan_Click"/>
                <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="22" Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock x:Name="WifiTitle" Text="—" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="WifiDetail" Style="{StaticResource Secondary}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="WifiListCard" Style="{StaticResource Card}" Padding="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="WifiStatus" Style="{StaticResource Secondary}" Margin="8,4,8,6"/>
                <ItemsControl x:Name="WifiList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="8,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Band}" Style="{StaticResource Secondary}" Width="56" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SecurityShort}" Style="{StaticResource Secondary}" Width="56" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Bars, Converter={x:Static c:BarsToGlyph.Instance}}" Style="{StaticResource Glyph}" Width="34" FontSize="16"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Ssid}"/>
                                    <TextBlock Style="{StaticResource Secondary}"><Run Text="{Binding Rssi, Mode=OneWay}"/> dBm · <Run Text="{Binding FrequencyMhz, Mode=OneWay}"/> MHz</TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="Wi-Fi hotspot" Style="{StaticResource SectionTitle}"/>
        <c:SettingCard Header="Phone hotspot" Description="Turn it on from the phone. Android won't let apps start it, and it switches off when the phone restarts. Turn off 'Turn off hotspot automatically' to keep it on." Glyph="&#xE704;">
            <Button Content="Open hotspot settings" Click="OpenTether_Click"/>
        </c:SettingCard>
        <TextBlock Style="{StaticResource Secondary}" Margin="2,10,0,0"
                   Text="USB tethering gives Windows a real network adapter through Android's own tethering. It's an internet connection, not a Wi-Fi card: Windows can't scan, join networks or use monitor mode through it."/>
    </StackPanel>
</UserControl>
