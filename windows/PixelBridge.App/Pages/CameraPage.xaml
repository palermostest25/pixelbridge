<UserControl x:Class="PixelBridge.App.Pages.CameraPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PixelBridge.App.Controls">
    <StackPanel>
        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartStop" Style="{StaticResource AccentButtonStyle}" MinWidth="130" Padding="14,6" Click="StartStop_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StartStopGlyph" Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StartStopText" Text="Start camera"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Camera" Style="{StaticResource TitleTextBlockStyle}"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Preview -->
                <Border CornerRadius="10" Background="#FF0B0C0E" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Viewbox Stretch="Uniform"><Grid Width="16" Height="9"/></Viewbox>
                        <Image x:Name="Preview" Stretch="Uniform"/>
                        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaceholderGlyph" Text="&#xE722;" Style="{StaticResource Glyph}" FontSize="40" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
                            <TextBlock x:Name="PlaceholderText" Text="Camera is off" Foreground="#AAFFFFFF" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="LiveChip" Visibility="Collapsed" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12" Padding="10,4" Background="#AA000000">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#FFE5484D" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LiveText" Text="LIVE" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <!-- Toolbar under preview -->
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button ToolTip="Save snapshot" Click="Snapshot_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Snapshot"/></StackPanel>
                        </Button>
                        <Button x:Name="RecordButton" Click="Record_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C8;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/><TextBlock x:Name="RecordText" Text="Record"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <ComboBox x:Name="Lens" MinWidth="150" HorizontalAlignment="Left" SelectionChanged="Lens_Changed" AutomationProperties.Name="Camera lens"/>

                </DockPanel>
                <TextBlock x:Name="Stats" Style="{StaticResource Mono}" Margin="2,14,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel><TextBlock Text="Zoom" FontWeight="SemiBold"/><TextBlock x:Name="ZoomText" HorizontalAlignment="Right"/></DockPanel>
                        <Slider x:Name="Zoom" Minimum="1" Maximum="8" Value="1" ValueChanged="Zoom_Changed" Margin="0,10,0,4" AutomationProperties.Name="Camera zoom"/>
                        <TextBlock Text="Stabilization" Margin="0,12,0,6"/>
                        <ComboBox x:Name="Stabilization" SelectionChanged="Controls_Changed" AutomationProperties.Name="Stabilization">
                            <ComboBoxItem Content="Automatic" Tag="auto"/><ComboBoxItem x:Name="Optical" Content="Optical (OIS)" Tag="optical"/>
                            <ComboBoxItem x:Name="Electronic" Content="Electronic" Tag="electronic"/><ComboBoxItem Content="Off" Tag="off"/>
                        </ComboBox>
                        <TextBlock x:Name="StabilizationState" Style="{StaticResource Secondary}" Margin="0,6,0,0"/>
                        <TextBlock Text="Orientation" Margin="0,14,0,6"/>
                        <ComboBox x:Name="Orientation" SelectionChanged="Controls_Changed" AutomationProperties.Name="Orientation">
                            <ComboBoxItem Content="Automatic" Tag="auto"/><ComboBoxItem Content="Landscape" Tag="0"/>
                            <ComboBoxItem Content="Rotate right" Tag="90"/><ComboBoxItem Content="Upside down" Tag="180"/><ComboBoxItem Content="Rotate left" Tag="270"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <c:SettingCard Header="Save power" Description="15 fps capture · lighter on both devices" Glyph="&#xE83E;">
                    <CheckBox x:Name="SavePower" Style="{StaticResource ToggleSwitch}" Click="Power_Click"/>
                </c:SettingCard>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" Margin="0,0,10,0"/>
                            <TextBlock Text="Windows webcam" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="VcamState" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Margin="0,10,0,4"/>
                        <TextBlock x:Name="VcamDetail" Style="{StaticResource Secondary}"/>
                        <Button Content="Open Windows Camera" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OpenCamera_Click"/>
                    </StackPanel>
                </Border>
                <c:SettingCard Header="Resolution" Glyph="&#xE7F4;">
                    <ComboBox x:Name="Resolution" MinWidth="130" SelectionChanged="Resolution_Changed">
                        <ComboBoxItem Content="720p" Tag="1280x720"/>
                        <ComboBoxItem Content="1080p" Tag="1920x1080"/>
                    </ComboBox>
                </c:SettingCard>
                <c:SettingCard Header="Quality" Glyph="&#xE9E9;">
                    <ComboBox x:Name="Bitrate" MinWidth="130" SelectionChanged="Bitrate_Changed">
                        <ComboBoxItem Content="Low (2 Mbps)" Tag="2000000"/>
                        <ComboBoxItem Content="High (4 Mbps)" Tag="4000000"/>
                        <ComboBoxItem Content="Best (8 Mbps)" Tag="8000000"/>
                    </ComboBox>
                </c:SettingCard>
                <c:SettingCard Header="Mirror video" Description="Preview and webcam" Glyph="&#xE8AB;">
                    <CheckBox x:Name="Mirror" Style="{StaticResource ToggleSwitch}" Click="Mirror_Click"/>
                </c:SettingCard>
                <c:SettingCard Header="Pause video" Description="Apps see a 'camera unavailable' image" Glyph="&#xE769;">
                    <CheckBox x:Name="Pause" Style="{StaticResource ToggleSwitch}" Click="Pause_Click"/>
                </c:SettingCard>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
