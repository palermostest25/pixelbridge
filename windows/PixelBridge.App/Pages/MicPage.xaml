<UserControl x:Class="PixelBridge.App.Pages.MicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PixelBridge.App.Controls">
    <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="StartStop" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" MinWidth="150" Padding="14,6" Click="StartStop_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartStopGlyph" Text="&#xE720;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StartStopText" Text="Start microphone"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Microphone" Style="{StaticResource TitleTextBlockStyle}"/>
        </DockPanel>

        <!-- Level -->
        <Border Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="LevelText" DockPanel.Dock="Right" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MicState" Text="Microphone is off" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"/>
                </DockPanel>
                <Grid Height="10" Margin="0,16,0,6">
                    <Border CornerRadius="5" Background="{DynamicResource ControlAltFillColorSecondaryBrush}"/>
                    <Border x:Name="LevelFill" CornerRadius="5" HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF30A46C" Offset="0"/>
                                <GradientStop Color="#FF30A46C" Offset="0.7"/>
                                <GradientStop Color="#FFF5A524" Offset="0.88"/>
                                <GradientStop Color="#FFE5484D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock Text="48 kHz mono from the Pixel's microphone over USB" Style="{StaticResource Secondary}"/>
            </StackPanel>
        </Border>

        <c:SettingCard Header="Mute" Description="Nothing is sent to Windows while muted" Glyph="&#xE74F;">
            <CheckBox x:Name="Mute" Style="{StaticResource ToggleSwitch}" Click="Mute_Click"/>
        </c:SettingCard>
        <c:SettingCard Header="Gain" Glyph="&#xE767;">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GainText" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="40" TextAlignment="Right"/>
                <Slider x:Name="Gain" Width="200" Minimum="0" Maximum="8" SmallChange="0.1" LargeChange="0.5" ValueChanged="Gain_Changed"/>
            </StackPanel>
        </c:SettingCard>

        <TextBlock Text="Use as a Windows microphone" Style="{StaticResource SectionTitle}"/>
        <Border x:Name="CableInfo" Style="{StaticResource Card}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="16,12">
            <DockPanel>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="CableInfoText" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <c:SettingCard Header="Send to" Description="Choose 'CABLE Input'; apps then use 'CABLE Output' as their microphone" Glyph="&#xE7F5;">
            <ComboBox x:Name="CableSelect" MinWidth="240" SelectionChanged="Cable_Changed"/>
        </c:SettingCard>
        <c:SettingCard Header="Listen on this PC" Description="Monitor the phone mic through your speakers or headphones" Glyph="&#xE7F6;">
            <ComboBox x:Name="MonitorSelect" MinWidth="240" SelectionChanged="Monitor_Changed"/>
        </c:SettingCard>
        <c:SettingCard Header="Latency buffer" Description="Lower is snappier; raise it if audio crackles" Glyph="&#xE916;">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="JitterText" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="50" TextAlignment="Right"/>
                <Slider x:Name="Jitter" Width="200" Minimum="40" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Jitter_Changed"/>
            </StackPanel>
        </c:SettingCard>
        <c:SettingCard Header="Record a test clip" Description="Up to 60 seconds, saved to Documents\PixelBridge" Glyph="&#xE7C8;">
            <Button x:Name="RecordButton" Content="Record" MinWidth="110" Click="Record_Click"/>
        </c:SettingCard>
    </StackPanel>
</UserControl>
