<UserControl x:Class="PixelBridge.App.Pages.BluetoothPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PixelBridge.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceTemplate">
            <DockPanel Margin="4,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Bars, Converter={x:Static c:BarsToGlyph.Instance}}" Style="{StaticResource Glyph}" FontSize="16" Margin="8,0,0,0"/>
                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE702;" Style="{StaticResource Glyph}" FontSize="15" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Width="80" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="ScanButton" Style="{StaticResource AccentButtonStyle}" MinWidth="140" Padding="14,6" Click="Scan_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/><TextBlock x:Name="ScanText" Text="Scan nearby"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Bluetooth" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Use the phone's Bluetooth Low Energy radio from this PC: find devices, connect, and read or write their data." Style="{StaticResource Secondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border x:Name="Banner" Style="{StaticResource Card}" Visibility="Collapsed" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Padding="16,12">
            <DockPanel>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Margin="0,0,12,0"/>
                <TextBlock x:Name="BannerText" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="NearbyTitle" Text="Nearby" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="4">
                    <Grid>
                        <ListBox x:Name="DeviceList" BorderThickness="0" Background="Transparent" MaxHeight="420" ItemTemplate="{StaticResource DeviceTemplate}"
                                 SelectionChanged="Device_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock x:Name="EmptyText" Text="Press Scan nearby to look for Bluetooth LE devices." Style="{StaticResource Secondary}" Margin="12,16" TextAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="Paired with the phone" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,14,0,8"/>
                <Border Style="{StaticResource Card}" Padding="4">
                    <ListBox x:Name="BondedList" BorderThickness="0" Background="Transparent" MaxHeight="260" ItemTemplate="{StaticResource DeviceTemplate}"
                             SelectionChanged="Device_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20">
                <Grid>
                    <StackPanel x:Name="NoSelection" HorizontalAlignment="Center" Margin="0,40">
                        <TextBlock Text="&#xE702;" Style="{StaticResource Glyph}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="Select a device" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="Detail" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="ConnectButton" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" MinWidth="110" Click="Connect_Click"/>
                            <StackPanel>
                                <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18"/>
                                <TextBlock x:Name="DetailInfo" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="GattTitle" Text="Characteristics" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8" Visibility="Collapsed"/>
                        <ItemsControl x:Name="CharList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Content="Read" Margin="4,0,0,0" Click="Read_Click" Visibility="{Binding CanRead, Converter={x:Static c:BoolToVisible.Instance}}"/>
                                                    <Button Content="Notify" Margin="4,0,0,0" Click="Notify_Click" Visibility="{Binding CanNotify, Converter={x:Static c:BoolToVisible.Instance}}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ShortUuid}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                                    <TextBlock Text="{Binding Properties}" Style="{StaticResource Secondary}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Mono}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding CanWrite, Converter={x:Static c:BoolToVisible.Instance}}">
                                                <Button DockPanel.Dock="Right" Content="Write" Margin="6,0,0,0" Click="Write_Click"/>
                                                <TextBox Tag="hexInput" FontFamily="Cascadia Mono, Consolas" FontSize="12" ToolTip="Hex bytes, e.g. 01 FF"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
