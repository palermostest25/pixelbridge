<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PixelBridge.Linux.MainWindow"
        Title="PixelBridge" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        Icon="/Assets/pixelbridge.ico" Background="{DynamicResource PbWindow}">
    <Grid ColumnDefinitions="240,*">
        <!-- Sidebar -->
        <DockPanel Background="{DynamicResource PbSidebar}">
            <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SystemAccentColor}">
                        <Border Width="11" Height="18" CornerRadius="2" BorderThickness="2" BorderBrush="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="PixelBridge" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Background="{DynamicResource PbSubtle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <ListBox x:Name="Nav" Classes="nav" Background="Transparent" SelectionChanged="Nav_Changed">
                <ListBoxItem Content="Home" Tag="home"/>
                <ListBoxItem Content="Messages" Tag="messages"/>
                <ListBoxItem Content="Calls" Tag="calls"/>
                <ListBoxItem Content="Contacts" Tag="contacts"/>
                <ListBoxItem Content="Compass" Tag="compass"/>
                <ListBoxItem Content="Phone tools" Tag="tools"/>
                <ListBoxItem Content="Notifications" Tag="notifications"/>
                <ListBoxItem Content="Camera" Tag="camera"/>
                <ListBoxItem Content="Microphone" Tag="mic"/>
                <ListBoxItem Content="Motion sensors" Tag="sensors"/>
                <ListBoxItem Content="Location" Tag="location"/>
                <ListBoxItem Content="Internet sharing" Tag="network"/>
                <ListBoxItem Content="Bluetooth" Tag="bluetooth"/>
                <ListBoxItem Content="Phone screen" Tag="phone"/>
                <ListBoxItem Content="Settings" Tag="settings"/>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="1">
            <ScrollViewer x:Name="DashboardScroll">
                <StackPanel Margin="36,28" MaxWidth="1000">
                    <!-- HOME -->
                    <StackPanel x:Name="PageHome">
                        <Border Classes="card" Padding="26,22">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="58" Height="104" CornerRadius="12" BorderThickness="3" BorderBrush="{DynamicResource PbTextSecondary}" Background="#101114" Margin="0,0,24,0">
                                    <TextBlock x:Name="HeroMark" Text="—" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#88FFFFFF" FontSize="20"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="DeviceName" Text="Your phone" FontSize="30" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DeviceStatus" Classes="secondary" FontSize="14"/>
                                    <WrapPanel x:Name="Chips" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="12" HorizontalAlignment="Right">
                                    <Button x:Name="ConnectButton" Classes="accent" Content="Connect" MinWidth="140" HorizontalContentAlignment="Center" Click="Connect_Click"/>
                                    <ToggleSwitch x:Name="PrivacySwitch" OnContent="Privacy mode" OffContent="Privacy mode" Click="Privacy_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="ActionCard" Classes="card" IsVisible="False" Background="{DynamicResource PbAttention}">
                            <DockPanel>
                                <Button x:Name="ActionButton" DockPanel.Dock="Right" Classes="accent" Click="Action_Click"/>
                                <StackPanel>
                                    <TextBlock x:Name="ActionTitle" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ActionText" Classes="secondary"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Classes="section" Text="Features"/>
                        <UniformGrid x:Name="Tiles" Columns="3"/>
                        <Grid ColumnDefinitions="*,12,*" Margin="0,8,0,0">
                            <Border Classes="card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Battery" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BatteryBig" Text="—" FontSize="32" FontWeight="SemiBold"/>
                                    <ProgressBar x:Name="BatteryBar" Maximum="100" Height="4"/>
                                    <TextBlock x:Name="BatteryDetail" Classes="secondary"/>
                                    <TextBlock Classes="secondary" Foreground="{DynamicResource PbCaution}"
                                               Text="If the phone gets hot, swells or smells unusual, stop and unplug it."/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="card">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Connection" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LinkSummary"/>
                                    <TextBlock x:Name="LinkPorts" Classes="mono secondary"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <ContentControl x:Name="PhoneHub" IsVisible="False"/>
                    <ContentControl x:Name="CompassHub" IsVisible="False"/>

                    <!-- CAMERA -->
                    <StackPanel x:Name="PageCamera" IsVisible="False">
                        <DockPanel Margin="0,0,0,18">
                            <Button x:Name="CamButton" DockPanel.Dock="Right" Classes="accent" Content="Start camera" Click="Cam_Click"/>
                            <TextBlock Classes="title" Text="Camera" Margin="0"/>
                        </DockPanel>
                        <Border CornerRadius="10" Background="#0B0C0E" ClipToBounds="True">
                            <Grid Height="320">
                                <Image x:Name="Preview" Stretch="Uniform"/>
                                <TextBlock x:Name="PreviewText" Text="Camera is off" Foreground="#AAFFFFFF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="LiveChip" IsVisible="False" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="12" Padding="10,4" Background="#AA000000">
                                    <TextBlock x:Name="LiveText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,24,*" Margin="0,18,0,6">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Lens" FontWeight="SemiBold"/>
                                <ComboBox x:Name="Lens" HorizontalAlignment="Stretch" SelectionChanged="Lens_Changed" AutomationProperties.Name="Camera lens"/>
                                <DockPanel Margin="0,8,0,0"><TextBlock Text="Zoom" FontWeight="SemiBold"/><TextBlock x:Name="ZoomText" HorizontalAlignment="Right"/></DockPanel>
                                <Slider x:Name="Zoom" Minimum="1" Maximum="8" Value="1" AutomationProperties.Name="Camera zoom"/>
                                <ToggleSwitch x:Name="Mirror" Content="Mirror preview and webcam" Click="CameraControls_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="Stabilization" FontWeight="SemiBold"/>
                                <ComboBox x:Name="Stabilization" HorizontalAlignment="Stretch" SelectionChanged="CameraControls_Changed">
                                    <ComboBoxItem Content="Automatic" Tag="auto"/><ComboBoxItem x:Name="Optical" Content="Optical (OIS)" Tag="optical"/>
                                    <ComboBoxItem x:Name="Electronic" Content="Electronic" Tag="electronic"/><ComboBoxItem Content="Off" Tag="off"/>
                                </ComboBox>
                                <TextBlock x:Name="StabilizationState" Classes="secondary"/>
                                <ComboBox x:Name="Orientation" HorizontalAlignment="Stretch" SelectionChanged="CameraControls_Changed">
                                    <ComboBoxItem Content="Automatic orientation" Tag="auto"/><ComboBoxItem Content="Landscape" Tag="0"/>
                                    <ComboBoxItem Content="Rotate right" Tag="90"/><ComboBoxItem Content="Upside down" Tag="180"/><ComboBoxItem Content="Rotate left" Tag="270"/>
                                </ComboBox>
                                <ToggleSwitch x:Name="SavePower" Content="Save power · 15 fps" Click="Power_Click"/>
                            </StackPanel>
                        </Grid>
                        <Border Classes="card" Margin="0,12,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Linux webcam (v4l2loopback)" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LoopbackText" Classes="secondary"/>
                                <Button Content="Set up PixelBridge Camera…" Click="SetupCam_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- MICROPHONE -->
                    <StackPanel x:Name="PageMic" IsVisible="False">
                        <DockPanel Margin="0,0,0,18">
                            <Button x:Name="MicButton" DockPanel.Dock="Right" Classes="accent" Content="Start microphone" Click="Mic_Click"/>
                            <TextBlock Classes="title" Text="Microphone" Margin="0"/>
                        </DockPanel>
                        <Border Classes="card" Padding="22">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="MicState" Text="Microphone is off" FontSize="18" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="MicLevel" Minimum="-60" Maximum="0" Height="8"/>
                                <TextBlock Classes="secondary" Text="When on, apps can choose “PixelBridge-Microphone” as their input. It's a PulseAudio/PipeWire virtual source, needs no root, and is removed when you turn it off."/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <DockPanel>
                                <ToggleSwitch x:Name="MuteSwitch" DockPanel.Dock="Right" Click="Mute_Click"/>
                                <TextBlock Text="Mute" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- SENSORS -->
                    <StackPanel x:Name="PageSensors" IsVisible="False">
                        <TextBlock Classes="title" Text="Motion sensors"/>
                        <Border Classes="card"><TextBlock x:Name="SensorTable" Classes="mono" TextWrapping="Wrap"/></Border>
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Developer API (read-only, this PC only)" FontWeight="SemiBold"/>
                                <SelectableTextBlock x:Name="ApiUrl" Classes="mono"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- LOCATION -->
                    <StackPanel x:Name="PageLocation" IsVisible="False">
                        <DockPanel Margin="0,0,0,18">
                            <Button x:Name="LocButton" DockPanel.Dock="Right" Classes="accent" Content="Start location" Click="Loc_Click"/>
                            <TextBlock Classes="title" Text="Location" Margin="0"/>
                        </DockPanel>
                        <Border Classes="card" Padding="22">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="LocTitle" Text="Location is off" FontSize="18" FontWeight="SemiBold"/>
                                <SelectableTextBlock x:Name="LocCoords" FontSize="22" FontFamily="DejaVu Sans Mono, monospace"/>
                                <TextBlock x:Name="LocDetail" Classes="secondary"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- NETWORK -->
                    <StackPanel x:Name="PageNetwork" IsVisible="False">
                        <TextBlock Classes="title" Text="Internet sharing"/>
                        <Border Classes="card" Padding="22">
                            <StackPanel Spacing="6">
                                <TextBlock Text="USB tethering" Classes="secondary"/>
                                <TextBlock x:Name="TetherTitle" Text="Checking…" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TetherDetail" Classes="secondary"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Phone Wi-Fi" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WifiText" Classes="secondary"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Wi-Fi hotspot" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HotspotDetail" Classes="secondary" TextWrapping="Wrap" Text="Uses the phone's saved hotspot name and password. Mobile data and extra battery may be used."/>
                                <WrapPanel>
                                    <Button x:Name="HotspotToggle" Content="Turn on hotspot…" Click="Hotspot_Click" Margin="0,0,10,0"/>
                                    <Button Content="Refresh hotspot" Click="HotspotRefresh_Click" Margin="0,0,10,0"/>
                                    <Button Content="Phone settings" Click="HotspotSettings_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="HotspotMessage" Classes="secondary" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="secondary" Text="Linux uses the phone through its cdc_ncm driver, with no install needed. It's an internet connection, not a Wi-Fi card. Use the hotspot controls above to share internet over Wi-Fi."/>
                    </StackPanel>

                    <!-- BLUETOOTH -->
                    <StackPanel x:Name="PageBluetooth" IsVisible="False">
                        <DockPanel Margin="0,0,0,18">
                            <Button x:Name="BleButton" DockPanel.Dock="Right" Classes="accent" Content="Scan nearby" Click="Ble_Click"/>
                            <TextBlock Classes="title" Text="Bluetooth" Margin="0"/>
                        </DockPanel>
                        <Border Classes="card"><TextBlock x:Name="BleList" Classes="mono" TextWrapping="Wrap" Text="Press Scan nearby."/></Border>
                    </StackPanel>

                    <!-- PHONE -->
                    <StackPanel x:Name="PagePhone" IsVisible="False">
                        <TextBlock Classes="title" Text="Phone screen"/>
                        <Border Classes="card">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="accent" Content="Show phone screen" Click="Scrcpy_Click"/>
                                <TextBlock Classes="secondary" VerticalAlignment="Center" Text="Uses your current USB or Wi-Fi connection. Use it to answer Android permission prompts."/>
                            </DockPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Connect over Wi-Fi" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WirelessDetail" Classes="secondary" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button x:Name="WirelessSetup" Content="Set up over USB…" Click="Wireless_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="WirelessOff" Content="Turn off wireless" Click="WirelessOff_Click"/>
                                </WrapPanel>
                                <Expander Header="Pair without a cable" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10" Margin="0,12,0,0">
                                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="On Android 11+, open Settings → System → Developer options → Wireless debugging → Pair device with pairing code. Keep that dialog open."/>
                                        <TextBlock Text="Pairing address (IP:port)"/>
                                        <TextBox x:Name="WirelessAddress" PlaceholderText="192.168.1.20:37123"/>
                                        <TextBlock Text="Six-digit pairing code"/>
                                        <TextBox x:Name="WirelessCode" PasswordChar="●"/>
                                        <TextBlock Text="Connection address (optional if discovered automatically)"/>
                                        <TextBox x:Name="WirelessConnectAddress"/>
                                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="The connection port is on the main Wireless debugging page and differs from the pairing port. If discovery fails, enter it and choose Connect paired phone."/>
                                        <WrapPanel>
                                            <Button x:Name="WirelessPair" Content="Pair &amp; connect" Click="WirelessPair_Click" Margin="0,0,10,0"/>
                                            <Button x:Name="WirelessConnect" Content="Connect paired phone" Click="WirelessConnect_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <TextBlock x:Name="WirelessMessage" Classes="secondary" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="ADB keys from another computer"/>
                                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Choose adbkey with adbkey.pub beside it. Current keys are backed up before reconnecting."/>
                                <Button Content="Import ADB keys…" Click="ImportKeys_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Pair" Click="Pair_Click"/>
                                <TextBlock x:Name="PairText" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- SETTINGS -->
                    <StackPanel x:Name="PageSettings" IsVisible="False">
                        <TextBlock Classes="title" Text="Settings"/>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Phone serial (empty = the only phone attached)" Classes="secondary"/>
                                <TextBox x:Name="SerialBox"/>
                                <ToggleSwitch x:Name="AutoConnect" OnContent="Connect automatically" OffContent="Connect automatically"/>
                                <ToggleSwitch x:Name="ShowOnConnect" Content="Bring dashboard forward when the phone connects"/>
                                <ToggleSwitch x:Name="AutoUpdateCompanion" Content="Update the phone companion automatically (matching signing key required)"/>
                                <ToggleSwitch x:Name="Autostart" OnContent="Start when I log in" OffContent="Start when I log in"/>
                                <Button Classes="accent" Content="Save" Click="Save_Click" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="AboutText" Classes="secondary"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="Toast" IsVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22" Padding="16,10" CornerRadius="8"
                    Background="{DynamicResource PbCard}" BorderBrush="{DynamicResource PbCardStroke}" BorderThickness="1">
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="560"/>
            </Border>
        </Grid>
    </Grid>
</Window>
